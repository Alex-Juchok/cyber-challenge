@model System.Collections.Generic.IReadOnlyCollection<CyberChallenge.Data.Models.News.NewsArticle>

@{
    ViewData["Title"] = "Управление новостями";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">Создать новость</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Заголовок</th>
                <th>Дата публикации</th>
                <th>Просмотры</th>
                <th>Фотография</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var article in Model)
            {
                <tr>
                    <td>@article.Title</td>
                    <td>@article.PublishedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@article.ViewsCount</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(article.ImagePath))
                        {
                            <img src="@article.ImagePath" alt="" style="width:80px;height:55px;object-fit:cover" />
                        }
                        else
                        {
                            <span class="text-muted">Нет</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-area="" asp-controller="News" asp-action="Details" asp-route-id="@article.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Открыть
                            </a>

                            <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-outline-primary">
                                Изменить
                            </a>

                            <form asp-action="Delete" asp-route-id="@article.Id" method="post"
                                  onsubmit="return confirm('Удалить эту новость?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Удалить
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
